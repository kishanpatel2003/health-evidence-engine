{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:health-bank:care-action-batch:1",
  "title": "Care action append batch",
  "type": "object",
  "required": ["schema_version", "patient_id", "events"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "patient_id": {"type": "string", "minLength": 1},
    "events": {"type": "array", "items": {"$ref": "#/$defs/event"}}
  },
  "$defs": {
    "citations": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^rec_[0-9a-f]{64}$"}},
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "action_id", "sequence", "event_type", "created_at", "occurred_at", "changes", "outcomes", "evidence_record_ids", "note"],
      "properties": {
        "event_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,96}$"},
        "action_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,96}$"},
        "sequence": {"type": "integer", "minimum": 1},
        "event_type": {"enum": ["created", "updated", "outcome_recorded", "corrected"]},
        "created_at": {"type": "string", "format": "date-time"},
        "occurred_at": {"type": ["object", "null"], "description": "Source-preserving original event time, never inferred from capture time."},
        "evidence_record_ids": {"$ref": "#/$defs/citations"},
        "note": {"type": "string", "minLength": 1},
        "changes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {"type": "string"},
            "area": {"type": "string"},
            "owner": {"type": "string"},
            "next_step": {"type": "string"},
            "status": {"enum": ["proposed", "agreed", "planned", "booking_reported", "scheduled_documented", "completed_reported", "completed_documented", "awaiting_clinician", "waiting_on_records", "paused", "cancelled", "declined"]},
            "due": {"type": ["object", "null"], "required": ["original"], "properties": {"original": {"type": "string"}}, "description": "Retain original relative timing beside any normalized date and method."},
            "decision_date": {"type": ["object", "null"]},
            "provider": {},
            "details": {},
            "dependencies": {"type": "array", "items": {"type": "string"}},
            "outcome_to_capture": {"type": "string"}
          }
        },
        "outcomes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["outcome_id", "description", "basis", "occurred_at", "evidence_record_ids"],
            "properties": {
              "outcome_id": {"type": "string", "minLength": 1},
              "description": {"type": "string", "minLength": 1},
              "basis": {"enum": ["caregiver_report", "clinical_document", "bank_evidence", "agent_interpretation"]},
              "occurred_at": {"type": ["object", "null"]},
              "evidence_record_ids": {"$ref": "#/$defs/citations"},
              "supersedes_outcome_id": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
